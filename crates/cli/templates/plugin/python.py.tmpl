#!/usr/bin/env python3
"""A forge plugin, generated by `forge plugin new`.

The host speaks newline-delimited JSON-RPC 2.0 over stdin/stdout to this process.
Three rules decide whether this file works:

  1. stdout carries protocol frames and NOTHING else. A stray `print()` is a
     malformed frame and the host will refuse the reply. Diagnostics go to
     stderr, which the host captures and logs but never parses.
  2. Every reply echoes the request's id exactly. The host refuses an id that
     differs, because a plugin that mixed up two replies would hand one call's
     answer to another.
  3. A tool that ran and failed answers with `isError: true`. A JSON-RPC error
     means "I could not attempt this at all" -- a different fact, reported to a
     different person (the operator, not the model).
"""

import json
import sys

PROTOCOL_VERSION = 1

# What this plugin offers the model. A tool's `schema` is JSON Schema over the
# `arguments` object; an absent schema is read as `{}`, never null.
TOOLS = [
    {
        "name": "hello",
        "description": 'Greet someone by name. Example: {"name":"world"}',
        "schema": {
            "type": "object",
            "properties": {"name": {"type": "string", "description": "Who to greet."}},
            "required": ["name"],
            "additionalProperties": False,
        },
    },
]

# The JSON-RPC numbers the protocol documents. The host prints them, so using
# the documented ones means a person greps for the number and finds the cause.
INVALID_PARAMS = -32602
METHOD_NOT_FOUND = -32601
PARSE_ERROR = -32700
INTERNAL_ERROR = -32603
REFUSED = -32000


def write(message):
    # `separators` keeps the frame on one line without padding: stdout is a pipe
    # here, not a file the user reads.
    sys.stdout.write(json.dumps(message, separators=(",", ":")) + "\n")
    sys.stdout.flush()


def reply(id_, result):
    write({"jsonrpc": "2.0", "id": id_, "result": result})


def fail(id_, code, message):
    write({"jsonrpc": "2.0", "id": id_, "error": {"code": code, "message": message}})


def call_tool(name, arguments):
    """One branch per tool. `None` means this plugin has no such tool."""
    arguments = arguments if isinstance(arguments, dict) else {}
    if name == "hello":
        who = arguments.get("name")
        if not isinstance(who, str) or who == "":
            return {"output": "hello needs arguments.name to be a non-empty string", "isError": True}
        return {"output": "hello, " + who, "isError": False}
    return None


def handle(message):
    has_id = "id" in message and message["id"] is not None
    method = message.get("method")
    id_ = message.get("id")

    if method == "initialize":
        # Answer the version you actually speak. Do not "mostly" agree: a v1 host
        # and a v2 plugin that nearly match disagree about something that matters.
        params = message.get("params")
        if not isinstance(params, dict) or params.get("protocolVersion") != PROTOCOL_VERSION:
            fail(id_, REFUSED, "this plugin speaks protocol version %d" % PROTOCOL_VERSION)
            return
        reply(
            id_,
            {
                "protocolVersion": PROTOCOL_VERSION,
                "name": "__NAME__",
                "version": "0.1.0",
                # Capabilities are how the host knows what not to ask. Claim only
                # what you implement: the host never calls an unclaimed method.
                "capabilities": {"tools": True, "prompts": False, "hooks": []},
            },
        )
        return

    if method == "tools/list":
        reply(id_, {"tools": TOOLS})
        return

    if method == "tools/call":
        params = message.get("params") or {}
        name = params.get("name")
        if not isinstance(name, str) or name == "":
            fail(id_, INVALID_PARAMS, "tools/call needs a tool name")
            return
        result = call_tool(name, params.get("arguments"))
        if result is None:
            fail(id_, INVALID_PARAMS, "no tool named %s" % json.dumps(name))
            return
        reply(id_, result)
        return

    if method == "initialized":
        # The host's acknowledgement of the handshake. No reply by definition.
        return

    if method == "shutdown":
        # Answer, flush, then return so the loop below sees no more input and
        # exits. Python flushes on the explicit call above; a bare exit here
        # could truncate a buffered frame.
        reply(id_, {})
        raise SystemExit(0)

    if has_id:
        fail(id_, METHOD_NOT_FOUND, "no method named %s" % json.dumps(method))
    # An unknown notification is ignorable by the JSON-RPC contract.


def main():
    # Line-buffered reads: one frame per line, so a loop over stdin is the whole
    # parser.
    for line in sys.stdin:
        line = line.strip()
        if line == "":
            continue
        try:
            message = json.loads(line)
        except ValueError as error:
            # There is no id to echo when the line is not JSON; null is what the
            # protocol allows for a parse error.
            fail(None, PARSE_ERROR, "the line is not JSON: %s" % error)
            continue
        try:
            handle(message)
        except SystemExit:
            raise
        except Exception as error:  # noqa: BLE001 - a plugin must still answer
            # A thrown handler is a bug in this file. Say so on stderr and still
            # answer, or the caller waits until its deadline for nothing.
            sys.stderr.write("__NAME__: handler threw: %r\n" % (error,))
            sys.stderr.flush()
            if isinstance(message, dict) and "id" in message:
                fail(message.get("id"), INTERNAL_ERROR, "the plugin failed inside %s" % message.get("method"))


if __name__ == "__main__":
    main()
