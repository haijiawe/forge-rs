#!/usr/bin/env node
// A forge plugin, generated by `forge plugin new`.
//
// The host speaks newline-delimited JSON-RPC 2.0 over stdin/stdout to this
// process. Three rules decide whether this file works; everything else is style:
//
//   1. stdout carries protocol frames and NOTHING else. A `console.log` is a
//      malformed frame and the host will refuse the reply. Diagnostics go to
//      stderr, which the host captures and logs but never parses.
//   2. Every reply echoes the request's id exactly. The host refuses an id that
//      differs, because a plugin that mixed up two replies would hand one call's
//      answer to another.
//   3. A tool that ran and failed answers with `isError: true`. A JSON-RPC error
//      means "I could not attempt this at all" — a different fact, reported to a
//      different person (the operator, not the model).
'use strict';

const PROTOCOL_VERSION = 1;

// What this plugin offers the model. A tool's `schema` is JSON Schema over the
// `arguments` object; an absent schema is read as `{}`, never null.
const TOOLS = [
  {
    name: 'hello',
    description: 'Greet someone by name. Example: {"name":"world"}',
    schema: {
      type: 'object',
      properties: {
        name: { type: 'string', description: 'Who to greet.' },
      },
      required: ['name'],
      additionalProperties: false,
    },
  },
];

// The JSON-RPC numbers the protocol documents. The host prints them, so using
// the documented ones means a person greps for the number and finds the cause.
const INVALID_PARAMS = -32602;
const METHOD_NOT_FOUND = -32601;
const PARSE_ERROR = -32700;
const INTERNAL_ERROR = -32603;

function write(message) {
  process.stdout.write(JSON.stringify(message) + '\n');
}

function reply(id, result) {
  write({ jsonrpc: '2.0', id: id, result: result });
}

function fail(id, code, message) {
  write({ jsonrpc: '2.0', id: id, error: { code: code, message: message } });
}

// One branch per tool. Return null for a name this plugin does not have: that is
// a caller bug (`-32602`), not a tool failure.
function callTool(name, arguments_) {
  const args = arguments_ && typeof arguments_ === 'object' ? arguments_ : {};
  if (name === 'hello') {
    const who = args.name;
    if (typeof who !== 'string' || who === '') {
      return { output: 'hello needs arguments.name to be a non-empty string', isError: true };
    }
    return { output: 'hello, ' + who, isError: false };
  }
  return null;
}

function handle(message) {
  const hasId = Object.prototype.hasOwnProperty.call(message, 'id') && message.id !== null;
  switch (message.method) {
    case 'initialize': {
      // Answer the version you actually speak. Do not "mostly" agree: a v1 host
      // and a v2 plugin that nearly match disagree about something that matters.
      const params = message.params;
      if (!params || params.protocolVersion !== PROTOCOL_VERSION) {
        return fail(
          message.id,
          -32000,
          'this plugin speaks protocol version ' + PROTOCOL_VERSION
        );
      }
      return reply(message.id, {
        protocolVersion: PROTOCOL_VERSION,
        name: '__NAME__',
        version: '0.1.0',
        // Capabilities are how the host knows what not to ask. Claim only what
        // you implement: the host never calls an unclaimed method.
        capabilities: { tools: true, prompts: false, hooks: [] },
      });
    }
    case 'tools/list':
      return reply(message.id, { tools: TOOLS });
    case 'tools/call': {
      const params = message.params || {};
      if (typeof params.name !== 'string' || params.name === '') {
        return fail(message.id, INVALID_PARAMS, 'tools/call needs a tool name');
      }
      const result = callTool(params.name, params.arguments);
      if (result === null) {
        return fail(
          message.id,
          INVALID_PARAMS,
          'no tool named ' + JSON.stringify(params.name)
        );
      }
      return reply(message.id, result);
    }
    case 'initialized':
      // The host's acknowledgement of the handshake. No reply by definition.
      return;
    case 'shutdown':
      // Answer first, then exit from the write callback. `process.exit()`
      // immediately after writing to a pipe can truncate the reply, and a plugin
      // that vanished mid-reply looks like a crash in the host's log.
      process.stdout.write(
        JSON.stringify({ jsonrpc: '2.0', id: message.id, result: {} }) + '\n',
        function () {
          process.exit(0);
        }
      );
      return;
    default:
      if (hasId) {
        return fail(
          message.id,
          METHOD_NOT_FOUND,
          'no method named ' + JSON.stringify(message.method)
        );
      }
      // An unknown notification is ignorable by the JSON-RPC contract.
      return;
  }
}

// Newline-delimited framing. Frames are lines, so a buffer that splits on '\n'
// is the whole parser.
let buffer = '';
process.stdin.setEncoding('utf8');
process.stdin.on('data', function (chunk) {
  buffer += chunk;
  let index = buffer.indexOf('\n');
  while (index >= 0) {
    const line = buffer.slice(0, index).trim();
    buffer = buffer.slice(index + 1);
    index = buffer.indexOf('\n');
    if (line === '') continue;
    let message;
    try {
      message = JSON.parse(line);
    } catch (error) {
      // There is no id to echo when the line is not JSON; null is what the
      // protocol allows for a parse error.
      fail(null, PARSE_ERROR, 'the line is not JSON: ' + error.message);
      continue;
    }
    try {
      handle(message);
    } catch (error) {
      // A thrown handler is a bug in this file. Say so on stderr and still
      // answer, or the caller waits until its deadline for nothing.
      process.stderr.write('__NAME__: handler threw: ' + (error && error.stack) + '\n');
      if (Object.prototype.hasOwnProperty.call(message, 'id')) {
        fail(message.id, INTERNAL_ERROR, 'the plugin failed inside ' + String(message.method));
      }
    }
  }
});

// EOF on stdin is the host saying "stop": exit rather than linger.
process.stdin.on('end', function () {
  process.exit(0);
});
