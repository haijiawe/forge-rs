{
  "name": "sessions_create_201",
  "description": "Creating a session returns 201 with an idle session whose log already contains session/start at lastSeq 1.",
  "request": {
    "method": "POST",
    "path": "/api/sessions",
    "body": {
      "workspace": "$WORKSPACE",
      "model": "conformance-model",
      "profile": "default"
    }
  },
  "expect": {
    "status": 201,
    "headers": {
      "Content-Type": "application/json; charset=utf-8"
    },
    "notEmpty": [
      "session.id",
      "session.createdAt",
      "session.updatedAt"
    ],
    "jsonContains": {
      "session": {
        "status": "idle",
        "lastSeq": 1,
        "turns": 0,
        "workspace": "$WORKSPACE",
        "model": "conformance-model"
      },
      "lastSeq": 1
    }
  }
}
